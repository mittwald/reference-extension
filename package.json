{
  "name": "@mittwald/reference-extension",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "init:encryption": "node scripts/generate-encryption-secrets.js",
    "dev": "dotenv -- vite dev --host",
    "dev:expose": "dotenv -- bash -c 'zrok share reserved $ZROK_RESERVED_TOKEN'",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:push": "drizzle-kit push",
    "db:generate-migrations": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 8081",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up",
    "docker:prod:build": "docker compose up --build",
    "docker:prod:down": "docker compose down"
  },
  "dependencies": {
    "@mittwald/api-client": "^4.503.0",
    "@mittwald/api-client-commons": "^4.503.0",
    "@mittwald/ext-bridge": "1.5.22",
    "@mittwald/flow-remote-react-components": "1.5.22",
    "@mittwald/mstudio-ext-react-components": "1.5.22",
    "@mittwald/react-ghostmaker": "^1.6.0",
    "@mittwald/react-use-promise": "^4.3.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@weissaufschwarz/mitthooks": "^0.3.1",
    "@weissaufschwarz/mitthooks-drizzle": "^0.1.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "envalid": "^8.2.0",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3"
  }
}
